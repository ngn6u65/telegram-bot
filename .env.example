# Required: Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Payment provider token (leave empty for Telegram Stars)
PROVIDER_TOKEN=

# Required: Comma-separated list of admin Telegram user IDs
ADMIN_IDS=

# Required: Comma-separated list of user IDs to receive notifications
NOTIFY_IDS=

# Optional: Path to SQLite database file (default: payments.db)
DATABASE_PATH=payments.db

# Optional: Flask health-check server port (default: 5000)
FLASK_PORT=5000
